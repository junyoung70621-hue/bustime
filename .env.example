# 서버에서: cp .env.example .env  → 값 채운 뒤  docker compose up -d --build
# .env 는 git 에 올라가지 않습니다.

# 서버에서 열 포트 (http://서버IP:8090)
WEB_PORT=8090

# http 로 접속하면 false (Secure 쿠키는 https 에서만 저장됨 → 로그인 불가)
# HTTPS 리버스 프록시 뒤에 두면 true
COOKIE_SECURE=false

# [공공데이터포털] 서울시 버스위치정보 일반 인증키(Decoding)
PUBLIC_DATA_API_KEY=

# [Supabase] Settings > API  (NEXT_PUBLIC_* 는 빌드 때 들어감 → 바꾸면 --build 로 재빌드)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 비밀번호: /admin 관리자, 현장 로그인
ADMIN_PASSWORD=
FIELD_PASSWORD=

# Gemini (OCR 자동입력)
GEMINI_API_KEY=

# [Teams 자동 업로드 — 메일 릴레이] SMTP_HOST·RELAY_MAIL_TO 비우면 비활성
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RELAY_MAIL_FROM=
RELAY_MAIL_TO=
