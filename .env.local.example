# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해서 ".env.local" 로 만든 뒤 값을 채우세요.
#   cp .env.local.example .env.local   (PowerShell: copy .env.local.example .env.local)
# ※ .env.local 은 git에 올라가지 않습니다. Vercel 에는 대시보드에서 동일 키를 등록하세요.
# ─────────────────────────────────────────────────────────────

# [공공데이터포털] 서울시 버스위치정보조회 서비스 인증키
# data.go.kr 마이페이지의 "일반 인증키(Decoding)" 값을 그대로 넣으세요.
# (코드에서 URLSearchParams 가 자동 인코딩하므로 Decoding 키를 권장)
PUBLIC_DATA_API_KEY=발급받은_디코딩_인증키

# [Supabase] 프로젝트 Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... (anon public key)

# [관리자 페이지] /admin 비밀번호 게이트 + 수정 기능에 필요.
# service_role 키: 관리자 수정(쓰기)에 필수. Settings > API > service_role secret.
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요(클라이언트 노출 금지).
SUPABASE_SERVICE_ROLE_KEY=eyJ... (service_role key)

# 관리자 페이지(/admin) 진입 비밀번호 (원하는 값으로 설정)
ADMIN_PASSWORD=원하는_관리자_비밀번호

# [Supabase DB 직접접속] 로컬 스크립트(scripts/fill-last-seq.mjs, db-setup.mjs)용.
# Supabase 대시보드 > Project Settings > Database > Connection info 에서 확인.
# ※ 앱(Vercel) 런타임에는 불필요하고, 로컬에서 스크립트 실행할 때만 필요합니다.
SUPABASE_DB_HOST=db.xxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=DB_비밀번호

# [Teams 자동 업로드 — 이메일 릴레이] 대폐차 PDF 저장/수정 시 지정 메일함으로 PDF 첨부 발송.
# Power Automate "새 메일 도착 시(무료)" 플로우가 첨부를 Teams 센터 폴더에 저장합니다.
# 메일 제목 형식: "대폐차|{센터}|{운수사}|{지급일}" → 플로우에서 split('|')[1]로 센터 추출.
# SMTP_HOST 와 RELAY_MAIL_TO 가 없으면 릴레이 비활성(저장에는 영향 없음). Vercel에도 동일 등록.
# 예) Gmail: host=smtp.gmail.com port=587 secure=false user=계정 pass=앱비밀번호
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=보내는_계정@gmail.com
SMTP_PASS=앱_비밀번호_16자리
RELAY_MAIL_FROM=보내는_계정@gmail.com
RELAY_MAIL_TO=플로우가_감시할_메일함@atecmobility.com

# [인천 체크리스트 팀즈 알림] Power Automate 웹훅(Workflows) URL.
# Teams 채널 > 워크플로 "웹훅 요청을 받으면 채널에 게시"로 만든 URL을 넣으세요.
# 인천 체크리스트 저장/수정 시 Adaptive Card 메시지가 게시됩니다. 미설정 시 비활성.
TEAMS_INCHEON_WEBHOOK_URL=https://...powerplatform.com/.../invoke?...sig=...
